{
  "name": "dterminal-pty-bridge",
  "version": "0.1.0",
  "description": "D-Terminal PTY sidecar — node-pty multiplexer (ADR-0001)",
  "main": "pty-bridge.js",
  "bin": "pty-bridge.js",
  "type": "commonjs",
  "scripts": {
    "start": "node pty-bridge.js",
    "test": "node --test tests/protocol.test.js tests/i18n-parity.test.js",
    "bundle": "pkg . --targets node20-win-x64 --output ../src-tauri/binaries/dterminal-pty-bridge-x86_64-pc-windows-msvc.exe",
    "bundle:x64": "pkg . --targets node20-win-x64 --output ../src-tauri/binaries/dterminal-pty-bridge-x86_64-pc-windows-msvc.exe",
    "bundle:arm64": "pkg . --targets node20-win-arm64 --no-bytecode --public --public-packages \"*\" --output ../src-tauri/binaries/dterminal-pty-bridge-aarch64-pc-windows-msvc.exe",
    "bundle:all": "npm run bundle && npm run bundle:arm64"
  },
  "dependencies": {
    "cbor-x": "^1.6.4",
    "node-pty": "^1.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "GPL-3.0-or-later",
  "author": "Orhan Engin OKAY",
  "devDependencies": {
    "@yao-pkg/pkg": "^6.20.0"
  },
  "pkg": {
    "assets": [
      "node_modules/node-pty/prebuilds/win32-x64/**/*",
      "node_modules/node-pty/prebuilds/win32-arm64/**/*",
      "node_modules/node-pty/lib/**/*",
      "node_modules/node-pty/package.json",
      "node_modules/node-pty/typings/**/*",
      "node_modules/cbor-x/**/*"
    ],
    "scripts": [
      "node_modules/node-pty/lib/**/*.js",
      "node_modules/cbor-x/**/*.js"
    ]
  }
}
